{
  "api_config": {
    "base_url": "https://webnodejs.investorgain.com",
    "gmp_endpoint": "/cloud/v2/report/data-read/331/1/9/2026/2026-27/0/all?search="
  },
  "gmp_mapping": {
    "fields": {
      "orderby": "~orderby1",
      "id": "~id",
      "nameHtml": "Name",
      "gmpHtml": "GMP",
      "fireRatingHtml": "Rating",
      "subscription": "Sub",
      "price": "Price (₹)",
      "estListingHtml": "Est Listing",
      "ipoSize": "IPO Size",
      "lot": "Lot",
      "peRatio": "~P/E",
      "openDate": "Open",
      "closeDate": "Close",
      "boaDate": "BoA Dt",
      "listingDate": "Listing",
      "gmpUpdated": "Updated-On",
      "ipoCategory": "~IPO_Category"
    },
    "regex": {
      "htmlAndEntity": "<.*?>|&[#\\w]+;",
      "status": ">([^<]+)</a>.*<span[^>]+>([A-Z]{1,2})</span>",
      "listed": ">\\s*([^<]+)</a>.*?L@([\\d.]+)\\s*\\(([^)]+)\\)",
      "mainValue": "<b>([^<]+)</b>",
      "dateValue": "^[^<]*"
    },
    "status": {
      "U":  { "label": "Upcoming",      "flag": "UPCOMING" },
      "O":  { "label": "Open",          "flag": "OPEN" },
      "C":  { "label": "Closed",        "flag": "CLOSE" },
      "CT": { "label": "Closing Today", "flag": "CLOSING_TODAY" },
      "LISTED": { "label": "Listed",    "flag": "LISTED" }
    },
    "tokens": {
      "fireIcon": "&#128293;",
      "listedTemplate": "Listed @ {price} ({gain})",
      "smeMarker": "SME"
    },
    "defaults": {
      "gmp": "--", "profit": "--", "investment": "--", "fireRating": "--", "status": "--"
    }
  }
}
